{
    "id": "hyprLayout",
    "name": "Hyprland Layout",
    "description": "Shows the tiling layout (dwindle, master, scrolling, monocle) of the active workspace on each bar's monitor",
    "version": "1.0.0",
    "author": "umbe",
    "icon": "dashboard",
    "type": "widget",
    "capabilities": ["dankbar-widget"],
    "component": "./HyprLayoutWidget.qml",
    "settings": "./HyprLayoutSettings.qml",
    "requires_dms": ">=2.0.0",
    "compositors": ["hyprland"],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
